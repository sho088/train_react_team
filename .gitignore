# --- Dependencies ---
# パッケージの実体。非常に重いのでリポジトリには絶対に入れない
node_modules/
.pnp
.pnp.js

# --- Build Outputs ---
# ビルド済みのファイル。ソースコードから生成できるので不要
dist/
build/
.next/
out/
bin/
obj/

# --- Environment Variables ---
# 秘密情報（APIキーやDBパスワード）。セキュリティ上、絶対に公開してはいけない
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# --- Debug Logs ---
# エラーログなど。個人の環境に依存するため不要
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Editor / IDE Settings ---
# エディタ固有の設定ファイル
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS Specific Files ---
# OSが自動生成する隠しファイル
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Testing / Coverage ---
# テスト結果やカバレッジレポート
coverage/
*.lcov
